digraph DevelopmentView {
  graph [bgcolor="white", pad="0.25", ranksep="0.65", nodesep="0.55", splines="polyline"];
  node [shape="component", style="filled", fontname="Helvetica", fontsize="9", color="#1f4e79", fillcolor="#e8f0f7"];
  edge [fontname="Helvetica", fontsize="8", color="#546e7a", arrowsize="0.7"];

  html [label="index.html\nDocument structure"];
  css [label="styles.css\nPresentation"];
  view [label="app.js\nView controller"];
  model [label="app.js\nPlanner model"];
  timer [label="app.js\nTimer controller"];
  storage [label="app.js\nStorage adapter"];
  tests [label="tests.html + tests.js\nTest harness", fillcolor="#edf6ed", color="#2e7d32"];

  html -> css [label=" styles"];
  html -> view [label=" loads"];
  view -> model [label=" commands"];
  view -> timer [label=" controls"];
  view -> storage [label=" load/save"];
  tests -> model [label=" tests", style="dashed"];
  tests -> timer [label=" tests", style="dashed"];
  tests -> storage [label=" tests", style="dashed"];
}
